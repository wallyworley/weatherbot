# Copy to .env and fill in.
DATABASE_URL=postgresql://weather:weather@localhost:5432/weather_bot

# Kalshi API credentials (https://trading-api.readme.io/reference/authentication)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Paper trading only until confidence is proven
PAPER_MODE=true

# Bankroll and sizing (USD)
BANKROLL_USD=1000
MAX_POSITION_PCT=0.02
KELLY_FRACTION=0.25
MIN_EDGE_BPS=200  # 2% minimum edge after fees to take a trade

# Alerts (fired when health-check flips RED).
# macOS Notification Center alerts always fire on Darwin (set ALERTS_ENABLED=false to mute).
# Add ALERT_PHONE to ALSO get iMessage notifications on your phone.
ALERTS_ENABLED=true
# ALERT_PHONE=+15551234567
