<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.walter.weatherbot-atmos</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/walterworley/Library/Scripts/weatherbot-atmos.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/walterworley/dev/weather_bot</string>
    <!-- Hourly at :11 — Open-Meteo serves the latest GFS run with ~1h lag -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>11</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/walterworley/dev/weather_bot/logs/atmos.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/walterworley/dev/weather_bot/logs/atmos.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
