<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.walter.weatherbot-calibration-drift</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/walterworley/Library/Scripts/weatherbot-calibration-drift.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/walterworley/dev/weather_bot</string>
    <!-- Weekly Sundays at 8:23 AM. Snapshots per-bucket calibration + flags drift -->
    <!-- since prior snapshot. Output: research/reports/calibration_<date>.json plus -->
    <!-- a one-line entry in research/reports/calibration_drift.log -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>23</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/walterworley/dev/weather_bot/logs/calibration-drift.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/walterworley/dev/weather_bot/logs/calibration-drift.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
